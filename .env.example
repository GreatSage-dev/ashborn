# Ashborn Co-Pilot Cloud Provider Keys
# Any key set here is automatically loaded by the local bridge on http://127.0.0.1:3000

# 1. Groq (100% Free, 30 req/min, Llama 3.3 70B, zero card required)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. OpenRouter (Free tiers for DeepSeek R1, Llama 3.3, Mistral)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Google AI Studio (Free Gemini 1.5 / 2.0 Flash)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 4. GitHub Models (Free access with personal GitHub token)
# Get your token at: https://github.com/settings/tokens
GITHUB_TOKEN=
